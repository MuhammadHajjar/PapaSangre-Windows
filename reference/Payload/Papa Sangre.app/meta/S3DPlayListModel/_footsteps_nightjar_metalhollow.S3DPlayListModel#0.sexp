      (name "foot_metalhollow_s1_R_a")
      (extension "m4a"))
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s1_L_b")
      (extension "m4a"))      
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s1_R_b")
      (extension "m4a"))
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s1_L_c")
      (extension "m4a"))
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s1_R_c")
      (extension "m4a"))
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s3_L_a")
      (extension "m4a"))      
    (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s3_R_a")
      (extension "m4a"))
    (bundle
      (path "nightjar_sounds/footsteps")
