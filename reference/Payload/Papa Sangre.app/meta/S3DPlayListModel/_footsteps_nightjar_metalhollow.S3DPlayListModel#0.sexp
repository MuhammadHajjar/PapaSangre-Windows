(playlist
  (name "_footsteps_nightjar_metalhollow")		;;; name used as the playlist key
  (repeat none)							;;; pick either of: none, start(first), last
  (sound
     (preload true)
     (bundle
      (path "nightjar_sounds/footsteps")
      (name "foot_metalhollow_s1_L_a")
      (extension "m4a"))      
    (bundle
