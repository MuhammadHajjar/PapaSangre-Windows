(playlist
  (name "_monster_ps2_cuckoo")
  (repeat none)

  (sound
    (spatialized true)
    (bundle
      (path "ps2/beach/Monster")
      (name "PAPA cuckoo Monster")
      (extension "wav")))
  (sound
    (spatialized no)
    (bundle
      (path "ps2/beach/Monster")
      (name "PAPA White noise Loop 2")
      (extension "wav")))
  (sound
    (spatialized true)
    (bundle
      (path "ps2/beach/Monster")
      (name "PAPA_cuckoo_monster_footsteps_loop")
      (extension "wav")))
)
