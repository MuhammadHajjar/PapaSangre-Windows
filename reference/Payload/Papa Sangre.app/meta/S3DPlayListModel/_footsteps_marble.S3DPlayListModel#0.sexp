(playlist
  (name "_footsteps_marble")				;;; name used as the playlist key
  (repeat none)							;;; pick either of: none, start(first), last
  (sound
     (preload true)
     (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_L_a")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_R_a")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_L_b")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_R_b")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_L_c")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s1_R_c")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_L_a")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_R_a")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_L_b")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_R_b")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_L_c")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_s3_R_c")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_trip")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_marble_shuffle")
      (extension "m4a"))
))