(playlist
  (name "_dilemmas")                    ;;; name used as the playlist key
  (repeat none)							;;; pick either of: none, start(first), last

  (sound
    (bundle
      (path "ps1/dilemmas")
      (name "dilemmaOutcome_0")
      (extension "m4a")))
  (sound
    (bundle
      (path "ps1/dilemmas")
      (name "dilemmaOutcome_1")
      (extension "m4a")))
  (sound
    (spatialized false)
