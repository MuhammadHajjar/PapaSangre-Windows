(playlist
  (name "_footsteps_sand-waterC")				;;; name used as the playlist key
  (repeat none)							;;; pick either of: none, start(first), last
  (sound
     (preload true)
     (bundle
      (path "ps1/footsteps")
      (name "foot_sand-waterC_s1_L")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_sand-waterC_s1_R")
      (extension "m4a"))
))