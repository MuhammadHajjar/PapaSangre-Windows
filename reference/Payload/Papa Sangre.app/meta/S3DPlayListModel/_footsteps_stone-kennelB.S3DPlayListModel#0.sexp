    (bundle
      (path "ps1/footsteps")
      (name "foot_stone-kennelB_s1_R")
      (extension "m4a"))
    (bundle
      (path "ps1/footsteps")
      (name "foot_stone-kennelB_s3_L")
      (extension "m4a"))      
    (bundle
      (path "ps1/footsteps")
      (name "foot_stone-kennelB_s3_R")
      (extension "m4a"))
))