(playlist
  (name "_footsteps_ps2_glass")				;;; name used as the playlist key
  (repeat none)                             ;;; pick either of: none, start(first), last
  (sound
    (bundle
      (path "ps2/footsteps")
      (name "foot_glass_s1_L_a")
      (extension "mp3"))      
    (bundle
      (path "ps2/footsteps")
      (name "foot_glass_s1_R_a")
      (extension "mp3"))
    (bundle
      (path "ps2/footsteps")
      (name "foot_glass_s3_L_a")
      (extension "mp3"))      
    (bundle
      (path "ps2/footsteps")
      (name "foot_glass_s3_R_a")
      (extension "mp3"))
))