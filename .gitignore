# Generated
build/
dist/
Run/*
!Run/*.cmd
config/
__pycache__/
*.pyc

# The original game.  The data the port runs on is committed - audio, maps,
# playlists, the message and object lists, and the HRTF table - so a clone
# builds and plays with nothing else to find.  The arm64 binary is here too,
# which is what the disassembler and the HRTF extractor read.  The code
# signature, artwork and nibs are not: nothing here needs them.
reference/*
!reference/Payload/
reference/Payload/*
!reference/Payload/Papa Sangre.app/
reference/Payload/Papa Sangre.app/*
!reference/Payload/Papa Sangre.app/ps1/
!reference/Payload/Papa Sangre.app/Exports/
!reference/Payload/Papa Sangre.app/meta/
!reference/Payload/Papa Sangre.app/*.wav
!reference/Payload/Papa Sangre.app/*.m4a
!reference/Payload/Papa Sangre.app/*.plist
!reference/Payload/Papa Sangre.app/Papa Sangre

# Derived from the original binary and regenerable with the scripts in tools/.
# The HRTF table is the exception: it is committed, so nobody has to have the
# binary to build.
tools/dis/
tools/ps_strings.txt
tools/classdump.txt

# Third-party, downloaded rather than committed
vendor/openal-soft-*-bin/
vendor/openal-soft-bin.zip
vendor/makemhr/
